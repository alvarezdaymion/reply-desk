# Copy to .env (never commit it) or export these in the environment your scheduler uses.
# Reply Desk sends email only in [sending] mode = "live", and only after a tap on a Telegram card.

# Instantly API v2 key with the emails scopes (read and create). The name lookup also needs
# leads:read, and [inbox] blocklist_unsubscribes needs block list access.
INSTANTLY_API_KEY=

# Telegram bot token from @BotFather, and the chat the cards go to
# (for a private chat with your bot, your own Telegram user ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional model drafts ([model] enabled = true, `uv sync --extra llm`).
ANTHROPIC_API_KEY=
